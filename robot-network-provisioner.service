[Unit]
Description=Robot temporary Wi-Fi provisioning portal
After=NetworkManager.service network.target
Wants=NetworkManager.service
Conflicts=ble-provisioning.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /opt/robot-network-provisioner/robot_provisioner.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/robot-network-provisioner

[Install]
WantedBy=multi-user.target
